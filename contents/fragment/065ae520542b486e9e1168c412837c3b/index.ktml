  <modified>2025-11-29T22:50:23+09:00</modified>
</head>

<body>
  <ul><li><p>問題: <a ref="https://atcoder.jp/contests/abc342/tasks/abc342_d">https://atcoder.jp/contests/abc342/tasks/abc342_d</a></p></li><li><p><math><![CDATA[A_iA_j]]></math>が平方数であるということは、素因数分解して<math><![CDATA[A_iA_j=a^{2n}b^{2m}c^{2n}\dots]]></math>のように書ける、ということ</p><ul><li><p><math><![CDATA[a,b,c,\dots]]></math>は素数</p></li><li><p>つまり、指数を2の倍数に揃えれば良い</p></li></ul></li><li><p>つまり、「<math><![CDATA[A_i]]></math>を素因数分解し、掛けて<math><![CDATA[A_i]]></math>の素因数の指数を全て2の倍数にできる非負整数は、<math><![CDATA[A_1,\dots,A_{i-1}]]></math>のうち何個あるか？」が分かれば、これの合計を取れば答えとなる</p></li><li><p>0と1のときの扱いに注意</p></li></ul><blockcode lang="cpp"><![CDATA[std::unordered_map<llong, llong> primeFactorize(llong n) {
  std::unordered_map<llong, llong> factors;

  if (n <= 1) {
    return factors;
  }

  while (n % 2 == 0) {
    factors[2]++;
    n /= 2;
  }

  for (llong i = 3; i * i <= n; i += 2) {
    while (n % i == 0) {
      factors[i]++;
      n /= i;
    }
  }

  if (n > 1) {
    factors[n]++;
  }

  return factors;
}

struct UnorderedSetHash {
  template <typename T>
  std::size_t operator()(const std::unordered_set<T> &set) const {
    std::size_t result = 0;

    for (const auto &e : set) {
      result += std::hash<T>{}(e);
    }

    return result;
  }
};

void answer() {
  llong N;
  read(N);
  std::unordered_map<std::unordered_set<llong>, llong, UnorderedSetHash> counts;
  llong result = 0;
  llong zeros = 0;

  for (llong i = 0; i < N; i++) {
    llong A_i;
    read(A_i);

    auto factors = primeFactorize(A_i);
    std::unordered_set<llong> factors2;

    for (auto &&[f, c] : factors) {
      if (c % 2 != 0) {
        factors2.insert(f);
      }
    }

    if (A_i != 0) {
      result += counts[factors2] + zeros;
    } else {
      result += i;
    }

    counts[factors2] += A_i != 0;
    zeros += A_i == 0;
  }

  writeln(result);
}]]></blockcode><ul><li><p>提出: <a ref="https://atcoder.jp/contests/abc342/submissions/71335196">https://atcoder.jp/contests/abc342/submissions/71335196</a></p></li></ul>
</body>

