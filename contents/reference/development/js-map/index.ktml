<?xml version="1.0" encoding="UTF-8"?>
<ktml version="0.1">

  <head>
    <title>JavaScript: Mapの使い方</title>
    <id>288ad5ed-6857-4418-93fd-dc527dfeee64</id>
    <created>2022-06-04T00:18:24+09:00</created>
    <modified>2022-06-04T00:18:24+09:00</modified>
  </head>

  <body>
    <h2>生成</h2>
    <blockcode lang="js"><![CDATA[const m1 = new Map([['a', 1], ['b', 2], ['c', 3]]);
// => { 'a' => 1, 'b' => 2, 'c' => 3 }]]></blockcode>

    <h2>要素数を取得</h2>
    <blockcode lang="js"><![CDATA[const m2 = new Map([['a', 1], ['b', 2], ['c', 3]]);
m2.size; // => 3]]></blockcode>

    <h2>値を取得</h2>
    <blockcode lang="js"><![CDATA[const m3 = new Map([['a', 1], ['b', 2], ['c', 3]]);
m3.get('a'); // => 1]]></blockcode>

    <h2>値を設定</h2>
    <blockcode lang="js"><![CDATA[const m4 = new Map([['a', 1], ['b', 2], ['c', 3]]);
m4.set('d', 4);
m4.set('e', 5);
m4; // => { 'a' => 1, 'b' => 2, 'c' => 3, 'd' => 4, 'e' => 5 }]]></blockcode>

    <h2>要素の存在を調べる</h2>
    <blockcode lang="js"><![CDATA[const m5 = new Map([['a', 1], ['b', 2], ['c', 3]]);
m5.has('a'); // => true
m5.has('d'); // => false]]></blockcode>

    <h2>要素を削除</h2>
    <blockcode lang="js"><![CDATA[const m6 = new Map([['a', 1], ['b', 2], ['c', 3]]);
m6.delete('b');
m6; // => { 'a' => 1, 'c' => 3 }]]></blockcode>

    <h2>全ての要素を削除</h2>
    <blockcode lang="js"><![CDATA[const m7 = new Map([['a', 1], ['b', 2], ['c', 3]]);
m7.clear();
m7; // => {}]]></blockcode>

    <h2>forによるイテレート</h2>
    <blockcode lang="js"><![CDATA[const m8 = new Map([['a', 1], ['b', 2], ['c', 3]]);

for (const [key, value] of m8) {
  m8.set(key, value * 2);
}

m8; // => { 'a' => 2, 'b' => 4, 'c' => 6 }]]></blockcode>
  </body>

</ktml>