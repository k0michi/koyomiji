<?xml version="1.0" encoding="UTF-8"?>
<ktml version="0.1">

<head>
  <title>積分の公式集</title>
  <id>07bdbf6d-5fc7-43e5-938f-59d68ee7ddd2</id>
  <created>2022-06-16T11:02:28+09:00</created>
  <modified>2022-06-18T01:36:34+09:00</modified>
</head>

<body>
  <blockmath><![CDATA[\int{x^n}dx = \frac{1}{n+1} x^{n+1} + C \quad \left(n \neq -1\right)]]></blockmath>
  <blockmath><![CDATA[\int{\frac{1}{x}}dx = \ln{\left|x\right|} + C]]></blockmath>
  <blockmath><![CDATA[\int{e^x}dx = e^{x} + C]]></blockmath>
  <blockmath><![CDATA[\int{e^{ax}}dx = \frac{1}{a} e^{ax} + C]]></blockmath>
  <blockmath><![CDATA[\int{a^x}dx = \frac{a^x}{\ln{a}} + C]]></blockmath>
  <blockmath><![CDATA[\int{\sin{x}}dx = -\cos{x} + C]]></blockmath>
  <blockmath><![CDATA[\int{\cos{x}}dx = \sin{x} + C]]></blockmath>
  <blockmath><![CDATA[\int{\frac{1}{\cos^2{x}}}dx = \tan{x} + C]]></blockmath>
  <blockmath><![CDATA[\int{\tan{x}}dx = -\ln{\left|\cos{x}\right|} + C]]></blockmath>
  <h2>部分積分 (integration by parts)</h2>
  <blockmath><![CDATA[\int f(x)g^{\prime}(x) = f(x)g(x) - \int f^{\prime}(x)g(x)dx]]></blockmath>
  <blockmath><![CDATA[\int_a^b f(x)g^{\prime}(x) = \left[f(x)g(x)\right]_a^b - \int_a^b f^{\prime}(x)g(x)dx]]></blockmath>
  <h2>置換積分 (integration by substitution)</h2>
  <p><math><![CDATA[x = g(t)]]></math>とおくと</p>
  <blockmath><![CDATA[\int f(x)dx = \int f(g(t))\frac{dx}{dt}dt]]></blockmath>
  <p><math><![CDATA[x = g(t)]]></math>とおくと</p>
  <blockmath><![CDATA[\int_a^b f(x)dx = \int_c^d f(g(t))\frac{dx}{dt}dt]]></blockmath>
  <p>ただし、<math><![CDATA[a = g(c), b = g(d)]]></math></p>
</body>

</ktml>