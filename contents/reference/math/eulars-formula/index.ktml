<ktml version="0.1">

<head>
  <title>オイラーの公式</title>
  <id>d8f8604c-9aec-4a02-bdda-5e6eb79a751c</id>
  <created>2022-06-16T12:11:41+09:00</created>
  <modified>2022-06-16T12:11:41+09:00</modified>
</head>

<body>
  <blockmath><![CDATA[e^{i\theta} = \cos{\theta} + i\sin{\theta}]]></blockmath>
  <blockmath><![CDATA[\cos{\theta} = \frac{1}{2} \left(e^{i\theta} + e^{-i\theta}\right)]]></blockmath>
  <blockmath><![CDATA[\sin{\theta} = \frac{1}{2i} \left(e^{i\theta} - e^{-i\theta}\right)]]></blockmath>
</body>

</ktml>